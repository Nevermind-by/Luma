    "The installer controls how the current version is replaced. Luma will not remove the existing app automatically.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The installer controls how the current version is replaced. Luma will not remove the existing app automatically."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установщик управляет заменой текущей версии. Luma не удаляет установленное приложение автоматически."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Installer steuert, wie die aktuelle Version ersetzt wird. Luma entfernt die vorhandene App nicht automatisch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’installeur contrôle le remplacement de la version actuelle. Luma ne supprimera pas automatiquement l’application existante."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El instalador controla cómo se reemplaza la versión actual. Luma no eliminará automáticamente la aplicación existente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装程序负责替换当前版本。Luma 不会自动删除现有应用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のバージョンの置き換えはインストーラが行います。Lumaが既存のアプリを自動的に削除することはありません。"
          }
        }
      }
    },

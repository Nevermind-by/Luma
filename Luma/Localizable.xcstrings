    "Complete the installer. It may ask you to remove the current version before continuing. Luma will detect the new version automatically.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete the installer. It may ask you to remove the current version before continuing. Luma will detect the new version automatically."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершите установку. Перед продолжением установщик может попросить удалить текущую версию. Luma автоматически обнаружит новую версию."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen Sie den Installer ab. Möglicherweise werden Sie aufgefordert, die aktuelle Version vor dem Fortfahren zu entfernen. Luma erkennt die neue Version automatisch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminez l’installation. Il peut vous demander de supprimer la version actuelle avant de continuer. Luma détectera automatiquement la nouvelle version."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa el instalador. Puede pedirte que elimines la versión actual antes de continuar. Luma detectará automáticamente la nueva versión."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成安装程序的操作。继续之前可能会要求删除当前版本。Luma 会自动检测新版本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストールを完了してください。続行する前に現在のバージョンの削除を求められる場合があります。Lumaが新しいバージョンを自動的に検出します。"
          }
        }
      }
    },

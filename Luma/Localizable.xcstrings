    "Luma needs to replace the installed application. Unsaved work in %@ may be lost.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Luma needs to replace the installed application. Unsaved work in %@ may be lost."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Luma необходимо заменить установленное приложение. Несохранённые данные в %@ могут быть потеряны."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Luma muss die installierte App ersetzen. Nicht gespeicherte Arbeit in %@ kann verloren gehen."
          }
        },
